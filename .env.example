# Brevo (Sendinblue) API key, used server-side only by src/pages/api/subscribe.ts
# to call Brevo's double opt-in endpoint. Get this from Brevo > Settings > API Keys.
#
# NEVER commit a real key to this file or any tracked file — .env.example only
# documents which variables are required. Put the real value in a local .env
# (already gitignored) for local dev, and in your Netlify site's
# Site settings > Environment variables for production.
BREVO_API_KEY=your_brevo_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# HarvestMath Plant Care — the checkout
#
# Four variables. Three of them are secrets and belong ONLY in
# Site settings > Environment variables on Netlify — never in a tracked file,
# never in a local .env you might later commit, never pasted into a chat.
#
# DEPLOY-PLANT-CARE.md has the order to set them in and the sandbox test.
# ─────────────────────────────────────────────────────────────────────────────

# Public. Identifies the merchant to PayPal and appears in the SDK URL in every
# buyer's browser, which is what "PUBLIC_" means to Astro. Not a secret.
PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# The same client id again, read server-side by the API routes. Astro does not
# expose PUBLIC_ variables to server code under a different name, and reusing one
# variable for both would mean a rename on the client silently breaking the
# server.
PAYPAL_CLIENT_ID=your_paypal_client_id_here

# SECRET. Half of the credential pair that can take money and issue refunds.
PAYPAL_SECRET=never_put_the_real_value_in_this_file

# SECRET. Signs the download links. Any long random string — 32+ bytes from a
# password manager, or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Changing it invalidates every download link already sent to a buyer, which is
# the emergency lever if one ever leaks.
DOWNLOAD_SECRET=never_put_the_real_value_in_this_file

# Optional. Point at PayPal's sandbox to test the whole flow without real money:
#   PAYPAL_API=https://api-m.sandbox.paypal.com
# Leave it unset in production — it defaults to https://api-m.paypal.com.
# PAYPAL_API=
