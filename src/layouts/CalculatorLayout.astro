---
import Layout from '../layouts/Layout.astro';
import BylineRow from '../components/BylineRow.astro';
import LeadMagnetForm from '../components/LeadMagnetForm.jsx';
import { leadMagnetConfig } from '../data/calculators';
import { getLastUpdated } from '../lib/lastUpdated';
import type { Calculator, Cluster } from '../data/calculators';

export interface Props {
  calculator: Calculator;
  cluster: Cluster;
  /** Short intro paragraph shown in the left column, alongside the sidebar. */
  intro: string;
  /** Author display name in the byline row. */
  authorName?: string;
  /** URL the author name links to (typically /about/). */
  authorUrl?: string;
  /** Absolute URL to the share/Pinterest image. */
  shareImage?: string;
  /**
   * Optional extra sentence appended after "Last updated: {date}." -- a
   * few calculator pages clarify that only the surrounding guidance
   * changed, not the calculator's math. The date itself always comes from
   * git history (see src/lib/lastUpdated.ts), never a prop.
   */
  lastUpdatedNote?: string;
  /**
   * Suppresses the automatic cluster-wide LeadMagnetForm rendered below,
   * for a page that places its own lead-magnet ask elsewhere (e.g. inline
   * right after the calculator's result, via LeadMagnetForm variant="inline"
   * inside the calculator component itself) and doesn't want a second,
   * competing ask lower on the same page. Defaults to false -- every other
   * calculator page keeps the standard bottom-of-page offer unchanged.
   */
  hideLeadMagnetForm?: boolean;
  /**
   * Pilot layout (Build Prompt: Calculator Page Redesign) -- ONE calculator
   * only (Raised Bed Soil) while it's under review. When true:
   *  - The right column becomes a sticky calculator panel (fed via the
   *    `calculator` named slot below) instead of the TOC sidebar.
   *  - The desktop TOC is dropped entirely for this page (two sticky
   *    elements can't share one column, and the calculator wins). Mobile is
   *    untouched either way -- `lg:` prefixes mean none of this applies
   *    below the desktop breakpoint.
   * Every other calculator page omits this prop and keeps the original
   * TOC-sidebar layout unchanged.
   */
  stickyCalculator?: boolean;
}

const {
  calculator,
  cluster,
  intro,
  authorName = 'HarvestMath Editors',
  authorUrl = '/about/',
  shareImage,
  lastUpdatedNote,
  hideLeadMagnetForm = false,
  stickyCalculator = false,
} = Astro.props;

// Derived from git history (see src/lib/lastUpdated.ts) instead of a
// hardcoded per-page constant -- see BlogPostLayout.astro for the same
// pattern applied to blog posts.
const lastUpdated = getLastUpdated(`src/pages/calculators/${calculator.slug}.astro`);
const formattedDate = new Date(lastUpdated).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const pageTitle = calculator.seoTitle ?? calculator.title;

// Same Brevo list per cluster as the cluster landing pages (see
// src/data/calculators.ts) -- every calculator page offers the cheat sheet
// for the cluster it belongs to.
const leadMagnet = leadMagnetConfig[cluster.slug];
---

<Layout title={pageTitle} description={calculator.metaDescription} rawTitle={Boolean(calculator.seoTitle)} ogImage={shareImage} pageType="website">
  <slot name="head" slot="head" />

  <!-- Hero band: breadcrumb + H1 + byline row -->
  <section class="border-b border-moss-100 bg-moss-50/60">
    <div class="container-wide py-7 sm:py-9">
      <nav class="flex text-sm text-bark-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-moss-800">Home</a>
        <span class="mx-2">/</span>
        <a href={`/clusters/${cluster.slug}/`} class="hover:text-moss-800">{cluster.name}</a>
        <span class="mx-2">/</span>
        <span class="text-bark-700">{calculator.shortTitle}</span>
      </nav>

      <h1 class="mt-3 font-display text-3xl font-semibold tracking-tight text-bark-900 sm:text-4xl">
        {calculator.title}
      </h1>

      {stickyCalculator ? (
        /* This page's action row (below) already has its own Share icon
           (opening the full Share/Embed/Cite modal), so the standard
           BylineRow's separate Pinterest/Facebook/X/copy-link row would be
           a second, duplicate share control right next to it. Skip
           BylineRow's share portion here rather than showing both --
           every other calculator page is untouched and keeps the full
           BylineRow with its own share icons. */
        <div class="mt-2.5 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-sm text-bark-500">
          <span>
            By{' '}
            <a href={authorUrl} class="font-medium text-bark-700 hover:text-moss-800">{authorName}</a>
          </span>
          <span class="text-bark-300" aria-hidden="true">&bull;</span>
          <time datetime={lastUpdated} class="text-bark-500">{formattedDate}</time>
          <!-- Pilot only: the thumbs/share/embed/cite action row, right in
               the byline line -- same spot "Share:" occupies on every other
               calculator page. No separator dot before it (unlike the
               "By ... • date" pair above): the icon row already reads as
               its own distinct element, and a dot here would sit centered
               against the icon-row+Google-button block below it (they
               stack via flex-col) rather than lining up with either row,
               so it just floats -- the gap spacing alone is enough
               separation from the date. -->
          <slot name="actions" />
        </div>
      ) : (
        <BylineRow
          authorName={authorName}
          authorUrl={authorUrl}
          lastUpdated={lastUpdated}
          shareTitle={calculator.title}
          shareDescription={calculator.metaDescription}
          shareImage={shareImage}
        />
      )}
    </div>
  </section>

  <!-- Two-column main area: intro+content left, sidebar right -->
  <div class="container-wide py-6 sm:py-8">
    {stickyCalculator ? (
      /* Pilot layout, follow-up correction -- match the standard (non-
         sticky) page's format as closely as possible: intro, then the
         calculator immediately after it, then TOC, then the rest of the
         content, then related calculators at the very end. That's a plain
         top-to-bottom order that needs no independent reordering between
         mobile and desktop -- DOM order (intro, then calculator, then a
         wrapper holding TOC/content/related) IS both the mobile stacking
         order and, via lg:col/row-start below, the desktop order.

         Two row tracks, not one per left-column piece: an earlier version
         gave each piece (intro/TOC/content/related) its own
         lg:row-start-N track, with the sticky calculator column spanning
         all 4 via lg:row-span-4. That works fine as long as every row is
         about as tall as it always was, but CSS Grid distributes a
         spanning item's extra required height across whichever auto
         tracks it spans -- so once the TOC became collapsible (short when
         closed), the grid still reserved the same total height across
         rows 1-4 to fit the tall sticky panel, and the leftover landed as
         blank space in the TOC's own row track, below its now-short
         content. Grouping TOC + content + related into one wrapper (one
         row track, row 2) fixes that: that row's height comes from the
         wrapper's real total content -- which is always dominated by the
         long article body -- regardless of whether the TOC inside it is
         open or collapsed, so there's no separate short track left for
         the grid to inflate. Row 1 is just the intro paragraph, above it.
         The calculator spans both rows (row-span-2, down from -4) in a
         second, sticky column, so it still stays visible alongside the
         entire left column and releases only at its bottom -- well above
         the LeadMagnet/Footer sections that live outside this grid
         entirely. Fixed 440px column (not content-sized) plus SSR'd
         markup from client:load means no layout shift on load. */
      <div class="lg:grid lg:grid-cols-[1fr_440px] lg:items-start lg:gap-12">
        <div class="lg:col-start-1 lg:row-start-1">
          <p class="mb-5 text-base leading-relaxed text-bark-600 sm:text-lg lg:mb-0">
            {intro}
          </p>
        </div>

        <div class="lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:sticky lg:top-24 lg:max-h-[calc(100vh-6.5rem)] lg:overflow-y-auto lg:overflow-x-hidden lg:pb-2">
          <slot name="calculator" />
        </div>

        <div class="mt-6 lg:col-start-1 lg:row-start-2 lg:mt-0">
          <slot name="toc" />

          <div class="min-w-0 mt-6">
            <slot />
            <p class="mt-12 text-sm text-bark-500">
              Last updated: {formattedDate}.{lastUpdatedNote && ` ${lastUpdatedNote}`}
            </p>
          </div>

          <div class="mt-6">
            <slot name="relatedCalculators" />
          </div>
        </div>
      </div>
    ) : (
      <div class="lg:grid lg:grid-cols-[1fr_240px] lg:gap-12">
        <!-- Left column: intro + default slot (calculator, article, etc.) -->
        <div class="min-w-0">
          <p class="mb-5 text-base leading-relaxed text-bark-600 sm:text-lg">
            {intro}
          </p>
          <slot />
          <p class="mt-12 text-sm text-bark-500">
            Last updated: {formattedDate}.{lastUpdatedNote && ` ${lastUpdatedNote}`}
          </p>
        </div>

        <!-- Right column: sticky sidebar -->
        <aside class="hidden lg:block">
          <div class="sticky top-24">
            <slot name="sidebar" />
          </div>
        </aside>
      </div>
    )}
  </div>

  {leadMagnet && !hideLeadMagnetForm && (
    <div class="container-wide">
      {/* Same column template as the content area above -- guarantees the
          form's column resolves to the exact same pixel width as the
          article/calculator column, even with no second item in this grid
          (the second track still reserves its own space either way). */}
      <div class={stickyCalculator ? 'lg:grid lg:grid-cols-[1fr_440px] lg:gap-12' : 'lg:grid lg:grid-cols-[1fr_240px] lg:gap-12'}>
        <div class="min-w-0">
          <LeadMagnetForm
            client:load
            listId={leadMagnet.listId}
            tag={leadMagnet.tag}
            clusterName={leadMagnet.clusterName}
            icon={leadMagnet.icon}
          />
        </div>
      </div>
    </div>
  )}

  <script>
    import { trackEvent, getCalculatorName } from '../lib/analytics';

    /**
     * `calculator_result_generated` — the "actually used the tool" signal.
     *
     * Implemented once here as a delegated listener rather than 25 times
     * inside the components, for two reasons:
     *
     *  - Only 16 of the 25 calculators expose a uniform `const result =
     *    useMemo(...)`; the other 9 compute results differently. A shared
     *    hook would need 9 bespoke integrations and would re-break whenever
     *    a calculator was refactored.
     *  - Every calculator recomputes live from its form controls, so the
     *    first genuine input change IS the moment a user-driven result
     *    appears on screen. Observing the input is equivalent to observing
     *    the output, and is far more robust.
     *
     * Fires at most once per pageview, deliberately: results recompute on
     * every keystroke, and counting those would measure typing speed rather
     * than usage. One event per pageview makes the GA4 count read as
     * "sessions where someone actually used the calculator".
     */
    let fired = false;

    function onCalculatorInput(event: Event) {
      if (fired) return;

      const target = event.target;
      if (!(target instanceof Element)) return;
      if (!target.matches('input, select, textarea')) return;

      // The email capture form lives on these pages too. Typing an address
      // there is a lead-magnet interaction, not calculator usage.
      if (target.closest('[data-lead-magnet]')) return;

      fired = true;
      trackEvent('calculator_result_generated', {
        calculator_name: getCalculatorName(),
      });
    }

    // Capture phase + passive: sees the event regardless of how React
    // handles it downstream, and never delays input handling.
    document.addEventListener('input', onCalculatorInput, { capture: true, passive: true });
    document.addEventListener('change', onCalculatorInput, { capture: true, passive: true });
  </script>
</Layout>
