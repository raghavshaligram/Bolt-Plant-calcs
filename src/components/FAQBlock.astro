---
// FAQBlock — renders an FAQ section from a data array with definition-first
// formatting. Automatically injects FAQPage JSON-LD schema into <head>.
//
// Each answer should open with a direct answer under 45 words before elaborating.
//
// Usage:
//   ---
//   const faqs = [
//     { q: 'How much soil do I need?', a: 'Multiply length × width × depth...' },
//   ];
//   ---
//   <FAQBlock id="my-calculator-faq" faqs={faqs} />

export interface FAQItem {
  q: string;
  a: string;
}

export interface Props {
  /** The id attribute placed on the wrapping <section>. Used for TOC anchor links. */
  id: string;
  /** Array of question/answer pairs. */
  faqs: FAQItem[];
  /** Optional heading override. Defaults to "FAQ". */
  heading?: string;
}

const { id, faqs, heading = 'FAQ' } = Astro.props;

// Answers are plain text by default, but may embed a single markdown-style
// link — [link text](/url/) — which we escape-then-selectively-unescape into
// a real <a> tag so FAQ answers can cross-link other pages, same as any
// other link on the site. Escaping first means anything else in the answer
// (including literal brackets/parens) can never be interpreted as markup.
function escapeHtml(str: string): string {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function renderAnswerHtml(text: string): string {
  return escapeHtml(text).replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
}

function plainTextAnswer(text: string): string {
  return text.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: plainTextAnswer(f.a),
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section id={id} aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`}>{heading}</h2>
  {faqs.map((f) => (
    <Fragment>
      <h3>{f.q}</h3>
      <p set:html={renderAnswerHtml(f.a)} />
    </Fragment>
  ))}
</section>
