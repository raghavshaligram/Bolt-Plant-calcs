---
// "Embed this calculator" UI, placed on every calculator page between the
// FAQ and the Sources section. Free embeds are the site's backlink engine:
// every site that embeds a widget links back to the matching full page here,
// both via the non-removable in-iframe attribution (EmbedLayout.astro) and
// via a plain on-page link right in the copy-paste snippet below (see the
// comment above iframeSnippet for why both exist).
import type { Calculator } from '../data/calculators';

export interface Props {
  calculator: Calculator;
}

const { calculator } = Astro.props;
const embedUrl = new URL(`/embed/${calculator.slug}/`, Astro.site).href;
const fullPageUrl = new URL(calculator.href, Astro.site).href;
const iframeId = `hm-embed-${calculator.slug}`;

// The iframe already carries a non-removable "Powered by" link inside the
// embed page itself (see EmbedLayout.astro) -- but a link that only exists
// inside a cross-origin iframe document is a weaker backlink signal than an
// ordinary link sitting directly in the embedder's own page HTML, since
// search engines don't reliably attribute anchor text/link equity across
// the iframe boundary. This caption puts a second, plain on-page link right
// in the copy-paste snippet, outside the iframe, so the backlink lands even
// if a crawler never credits the one inside the widget. Belt and suspenders:
// this one is technically removable by whoever pastes the snippet; the
// in-iframe one isn't.
const iframeSnippet = `<iframe id="${iframeId}" src="${embedUrl}"
  width="100%" height="600" style="border:0;max-width:680px"
  title="${calculator.title} by HarvestMath"></iframe>
<p style="font-size:12px;color:#64748b;margin:6px 0 0;max-width:680px;">Powered by <a href="${fullPageUrl}" style="color:#3f6b4a;text-decoration:none;font-weight:600;">HarvestMath</a></p>`;

const resizeScript = `<script>
(function () {
  window.addEventListener('message', function (e) {
    if (!e || !e.data || e.data.type !== 'hm-embed-resize') return;
    if (e.data.calculator !== '${calculator.slug}') return;
    var iframe = document.getElementById('${iframeId}');
    if (iframe && e.data.height) iframe.style.height = e.data.height + 'px';
  });
})();
</script>`;
---

<section id={`embed-this-calculator-${calculator.slug}`} class="not-prose mt-10 rounded-2xl border border-moss-100 bg-moss-50/50 p-6">
  <h2 class="font-display text-lg font-semibold text-bark-900">Embed this calculator on your site</h2>
  <p class="mt-2 text-sm text-bark-600">
    Free to use on your own site — just keep the visible attribution link included below the widget.
  </p>

  <label class="mt-4 block text-xs font-semibold uppercase tracking-wide text-bark-500" for={`embed-snippet-${calculator.slug}`}>
    Embed code
  </label>
  <div class="relative mt-1.5">
    <textarea
      id={`embed-snippet-${calculator.slug}`}
      class="hm-embed-textarea w-full resize-none rounded-lg border border-moss-200 bg-white p-3 pr-16 font-mono text-xs leading-relaxed text-bark-700"
      rows="5"
      readonly
      onfocus="this.select()"
    >{iframeSnippet}</textarea>
    <button
      type="button"
      class="hm-embed-copy-btn absolute right-2 top-2 rounded-md border border-moss-200 bg-white px-2.5 py-1 text-xs font-medium text-moss-800 shadow-sm transition hover:bg-moss-50"
      data-copy-target={`embed-snippet-${calculator.slug}`}
      data-calculator={calculator.slug}
    >
      Copy
    </button>
  </div>

  <details class="mt-3 text-sm text-bark-600">
    <summary class="cursor-pointer select-none font-medium text-bark-700">
      Optional: auto-resize script (recommended)
    </summary>
    <p class="mt-2">
      Add this once anywhere on the page and the widget resizes itself to fit its content, instead of scrolling inside a fixed 600px box:
    </p>
    <div class="relative mt-2">
      <textarea
        id={`embed-resize-script-${calculator.slug}`}
        class="hm-embed-textarea w-full resize-none rounded-lg border border-moss-200 bg-white p-3 pr-16 font-mono text-xs leading-relaxed text-bark-700"
        rows="7"
        readonly
        onfocus="this.select()"
      >{resizeScript}</textarea>
      <button
        type="button"
        class="hm-embed-copy-btn absolute right-2 top-2 rounded-md border border-moss-200 bg-white px-2.5 py-1 text-xs font-medium text-moss-800 shadow-sm transition hover:bg-moss-50"
        data-copy-target={`embed-resize-script-${calculator.slug}`}
        data-calculator={calculator.slug}
      >
        Copy
      </button>
    </div>
  </details>

  <p class="mt-3 text-sm">
    <a href={`/embed/${calculator.slug}/`} target="_blank" rel="noopener" class="font-medium text-moss-700 hover:text-moss-900">
      Preview the embed version →
    </a>
    <span class="text-bark-400"> · </span>
    <a href="/embed/" class="font-medium text-moss-700 hover:text-moss-900">
      See all embeddable calculators
    </a>
  </p>
</section>

<script>
  import { trackEvent } from '../lib/analytics';

  // Delegated, capture-free click listener -- this component is included on
  // every calculator page, so this script tag is present once per page.
  // Safe to attach unconditionally (no dedupe guard needed).
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement)?.closest<HTMLButtonElement>('.hm-embed-copy-btn');
    if (!btn) return;
    const targetId = btn.dataset.copyTarget;
    const textarea = targetId ? document.getElementById(targetId) as HTMLTextAreaElement | null : null;
    if (!textarea) return;

    const original = btn.textContent;
    try {
      await navigator.clipboard.writeText(textarea.value);
      btn.textContent = 'Copied!';
    } catch {
      // Clipboard API unavailable (older browser, non-HTTPS, etc.) -- fall
      // back to select-and-let-the-user-Ctrl+C, which onfocus="this.select()"
      // on the textarea already sets up.
      textarea.focus();
      textarea.select();
      btn.textContent = 'Select & copy';
    }
    trackEvent('embed_snippet_copied', { calculator: btn.dataset.calculator });
    setTimeout(() => {
      btn.textContent = original;
    }, 2000);
  });
</script>
