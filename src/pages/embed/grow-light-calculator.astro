---
// Auto-generated-style embed page for "grow-light-calculator" -- thin by design, mirrors
// the shape of src/pages/calculators/grow-light-calculator.astro but wraps EmbedLayout
// instead of CalculatorLayout, with none of the surrounding article/FAQ/lead
// magnet content. See src/layouts/EmbedLayout.astro for why this has to be
// one file per calculator rather than a single [calculator].astro dynamic
// route.
import EmbedLayout from '../../layouts/EmbedLayout.astro';
import GrowLightCalculator from '../../components/calculators/GrowLightCalculator.tsx';
import { getCalculator } from '../../data/calculators';

const calculator = getCalculator('grow-light-calculator')!;
---

<EmbedLayout calculator={calculator}>
  <GrowLightCalculator client:load />
</EmbedLayout>
