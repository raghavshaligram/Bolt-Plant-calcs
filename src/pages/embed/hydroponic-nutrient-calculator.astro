---
// Auto-generated-style embed page for "hydroponic-nutrient-calculator" -- thin by design, mirrors
// the shape of src/pages/calculators/hydroponic-nutrient-calculator.astro but wraps EmbedLayout
// instead of CalculatorLayout, with none of the surrounding article/FAQ/lead
// magnet content. See src/layouts/EmbedLayout.astro for why this has to be
// one file per calculator rather than a single [calculator].astro dynamic
// route.
import EmbedLayout from '../../layouts/EmbedLayout.astro';
import HydroponicNutrientCalculator from '../../components/calculators/HydroponicNutrientCalculator.tsx';
import { getCalculator } from '../../data/calculators';

const calculator = getCalculator('hydroponic-nutrient-calculator')!;
---

<EmbedLayout calculator={calculator}>
  <HydroponicNutrientCalculator client:load />
</EmbedLayout>
