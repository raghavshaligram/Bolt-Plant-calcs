---
// Auto-generated-style embed page for "npk-calculator" -- thin by design, mirrors
// the shape of src/pages/calculators/npk-calculator.astro but wraps EmbedLayout
// instead of CalculatorLayout, with none of the surrounding article/FAQ/lead
// magnet content. See src/layouts/EmbedLayout.astro for why this has to be
// one file per calculator rather than a single [calculator].astro dynamic
// route.
import EmbedLayout from '../../layouts/EmbedLayout.astro';
import NpkCalculator from '../../components/calculators/NpkCalculator.tsx';
import { getCalculator } from '../../data/calculators';

const calculator = getCalculator('npk-calculator')!;
---

<EmbedLayout calculator={calculator}>
  <NpkCalculator client:load />
</EmbedLayout>
