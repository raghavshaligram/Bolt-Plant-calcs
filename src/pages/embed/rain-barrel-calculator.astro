---
// Auto-generated-style embed page for "rain-barrel-calculator" -- thin by design, mirrors
// the shape of src/pages/calculators/rain-barrel-calculator.astro but wraps EmbedLayout
// instead of CalculatorLayout, with none of the surrounding article/FAQ/lead
// magnet content. See src/layouts/EmbedLayout.astro for why this has to be
// one file per calculator rather than a single [calculator].astro dynamic
// route.
import EmbedLayout from '../../layouts/EmbedLayout.astro';
import RainBarrelCalculator from '../../components/calculators/RainBarrelCalculator.tsx';
import { getCalculator } from '../../data/calculators';

const calculator = getCalculator('rain-barrel-calculator')!;
---

<EmbedLayout calculator={calculator}>
  <RainBarrelCalculator client:load />
</EmbedLayout>
