---
// Auto-generated-style embed page for "seed-starting-calculator" -- thin by design, mirrors
// the shape of src/pages/calculators/seed-starting-calculator.astro but wraps EmbedLayout
// instead of CalculatorLayout, with none of the surrounding article/FAQ/lead
// magnet content. See src/layouts/EmbedLayout.astro for why this has to be
// one file per calculator rather than a single [calculator].astro dynamic
// route.
import EmbedLayout from '../../layouts/EmbedLayout.astro';
import SeedStartingCalculator from '../../components/calculators/SeedStartingCalculator.tsx';
import { getCalculator } from '../../data/calculators';

const calculator = getCalculator('seed-starting-calculator')!;
---

<EmbedLayout calculator={calculator}>
  <SeedStartingCalculator client:load />
</EmbedLayout>
