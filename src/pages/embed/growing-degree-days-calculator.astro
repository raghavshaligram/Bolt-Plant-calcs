---
// Auto-generated-style embed page for "growing-degree-days-calculator" -- thin by design, mirrors
// the shape of src/pages/calculators/growing-degree-days-calculator.astro but wraps EmbedLayout
// instead of CalculatorLayout, with none of the surrounding article/FAQ/lead
// magnet content. See src/layouts/EmbedLayout.astro for why this has to be
// one file per calculator rather than a single [calculator].astro dynamic
// route.
import EmbedLayout from '../../layouts/EmbedLayout.astro';
import GrowingDegreeDaysCalculator from '../../components/calculators/GrowingDegreeDaysCalculator.tsx';
import { getCalculator } from '../../data/calculators';

const calculator = getCalculator('growing-degree-days-calculator')!;
---

<EmbedLayout calculator={calculator}>
  <GrowingDegreeDaysCalculator client:load />
</EmbedLayout>
