---
// Auto-generated-style embed page for "cubic-yard-calculator" -- thin by design, mirrors
// the shape of src/pages/calculators/cubic-yard-calculator.astro but wraps EmbedLayout
// instead of CalculatorLayout, with none of the surrounding article/FAQ/lead
// magnet content. See src/layouts/EmbedLayout.astro for why this has to be
// one file per calculator rather than a single [calculator].astro dynamic
// route.
import EmbedLayout from '../../layouts/EmbedLayout.astro';
import CubicYardCalculator from '../../components/calculators/CubicYardCalculator.tsx';
import { getCalculator } from '../../data/calculators';

const calculator = getCalculator('cubic-yard-calculator')!;
---

<EmbedLayout calculator={calculator}>
  <CubicYardCalculator client:load />
</EmbedLayout>
