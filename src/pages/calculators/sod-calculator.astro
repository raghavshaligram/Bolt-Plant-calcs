    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Enter your lawn’s dimensions',
      text: 'Enter your lawn’s dimensions for the shape you chose.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Select your grass type and waste factor',
      text: 'Select your grass type (or use the industry-standard default) and a waste factor for your lawn’s edges.',
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Read your pallet and piece count',
