  '@type': 'HowTo',
  name: 'Calculate how much sod you need in pallets, pieces, and square feet',
  description:
    'Use the sod calculator to find total square footage, pallets, and individual pieces of sod needed for a lawn of any shape, by grass type and waste factor.',
  totalTime: 'PT1M',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Choose your lawn shape',
