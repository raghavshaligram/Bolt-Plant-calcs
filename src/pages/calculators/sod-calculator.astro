  { grass: 'Zoysia', season: 'Warm', coverage: '~400 sq ft', soldAs: 'Slabs' },
  { grass: 'St. Augustine', season: 'Warm', coverage: '~450 sq ft', soldAs: 'Slabs' },
  { grass: 'Centipede', season: 'Warm', coverage: '~450 sq ft', soldAs: 'Slabs' },
  { grass: 'Tall Fescue', season: 'Cool', coverage: '~500 sq ft', soldAs: 'Rolls' },
  { grass: 'Kentucky Bluegrass', season: 'Cool', coverage: '~500 sq ft', soldAs: 'Rolls' },
  { grass: 'Ryegrass', season: 'Cool', coverage: '~600 sq ft', soldAs: 'Rolls' },
];

const faqs = [
  {
    q: 'How many square feet are in a pallet of sod?',
    a: 'A standard pallet of sod covers roughly 450 square feet — the Turfgrass Producers International industry standard. Actual coverage varies by grass type: about 400–450 sq ft for warm-season grasses cut as thicker slabs, and 500–600 sq ft for cool-season grasses cut thinner and sold as rolls. Always confirm the exact figure with your supplier before ordering.',
  },
  {
    q: 'How much sod do I need for a 1,000 square foot lawn?',
    a: 'With a typical 10% waste factor for curved edges, a 1,000 sq ft lawn needs about 1,100 sq ft of sod ordered. At the 450 sq ft/pallet industry standard, that’s 1,100 ÷ 450 = 2.4, rounded up to 3 pallets. The calculator above gives the exact count for your specific grass type and waste factor.',
  },
  {
    q: 'Is sod better than seed?',
    a: 'Neither is universally better — sod gives an instant, usable lawn and holds slopes that seed can wash off of, but costs substantially more. Seed is far cheaper and offers more grass variety, but takes a full season to establish and needs consistent watering the entire time. Starting from seed instead? Use our [Grass Seed Calculator](/calculators/grass-seed-calculator/).',
  },
  {
    q: 'How do I measure an irregular lawn for sod?',
    a: 'Break the lawn into simple rectangles — a main section plus smaller ones for any L-shaped extensions — measure each one separately, then add the areas together. The calculator above has a Multiple Sections mode built for exactly this: enter each rectangle’s length and width and it sums them automatically.',
  },
  {
    q: 'How long can sod sit before you lay it?',
    a: 'Sod should be installed within 24 hours of delivery. Fresh-cut sod carries only a thin layer of soil, so it starts to dry out, yellow, and heat up on the pallet quickly, especially in warm weather — the longer it waits, the harder it struggles to root once it’s down.',
  },
];

const howToJsonLd = {
