---
/**
 * /plant-care/updates/ — the permanent route back, and the changelog.
 *
 * This is the page a buyer bookmarks. It is public and unlinked from site
 * navigation: anyone who has the address can read what changed, and the
 * download itself still needs a token, so the page being public costs nothing.
 *
 * The same honour-system position as the app URL — stated in the brief and
 * accepted deliberately rather than solved with licence keys and accounts,
 * which would be a worse product for every honest buyer in order to inconvenience
 * a dishonest one who can simply pass on the file anyway.
 *
 * Indexable once launched, so a buyer who forgot the address can find it.
 */
import Layout from '../../layouts/Layout.astro';
import { APP_URL, FACTS, LAUNCHED, PATHS, PRODUCT_NAME } from '../../data/plantCare';

interface Release {
  version: string;
  date: string;
  headline: string;
  points: string[];
}

/**
 * Newest first. One entry per build that reached a buyer.
 *
 * Written in terms of what changed for the person using it, not what changed in
 * the repository — "pruning and dusting now have their own schedules" is a
 * changelog; "added CareType union members" is a commit message.
 */
const RELEASES: Release[] = [
  {
    version: '1.0',
    date: '2026-09-13',
    headline: 'First release.',
    points: [
      `${FACTS.species} plants across ${FACTS.genera} genera, with every pet-safety verdict traced to a row on the ASPCA list.`,
      `${FACTS.careTypes} care types — watering, feeding, misting, pruning, dusting, repotting and turning — each worked out from species, pot size, indoors or out, season and hardiness zone.`,
      'Every interval shows the factors behind it, and can be overridden.',
      `The ${FACTS.diagnosisTrees} diagnosis walkthroughs from the HarvestMath problem guides, working offline, writing their result to the plant's journal.`,
      'A light meter and a pot measurer, both honest about their accuracy, both usable without a camera.',
      'Zone and frost dates, companion planting and pot size conversions — the same data as the calculators on this site.',
      'Optional live weather, off by default, with no provider bundled.',
    ],
  },
];
---

<Layout
  title={`Updates · ${PRODUCT_NAME}`}
  description={`Version history and downloads for ${PRODUCT_NAME}. Updates are free forever.`}
  noindex={!LAUNCHED}
  canonical={`https://harvestmath.com${PATHS.updates}`}
>
  <section class="bg-sand-50">
    <div class="container-prose py-12">
      <h1 class="text-3xl font-semibold tracking-tight text-bark-900">{PRODUCT_NAME} — updates</h1>
      <p class="mt-4 text-base leading-relaxed text-bark-600">
        Updates are free forever. There is no upgrade to buy and no version that stops working — the copy you already
        have keeps running exactly as it does today, whether or not you ever come back here.
      </p>

      <div class="mt-8 card">
        <h2 class="font-display text-lg font-semibold text-bark-900">Getting the newest version</h2>
        <div class="mt-3 space-y-3 text-sm leading-relaxed text-bark-600">
          <p>
            <strong>If you installed the app:</strong> nothing to do. It checks for a newer version whenever you open it
            with a connection, and tells you when one is ready rather than reloading underneath you.
          </p>
          <p>
            <strong>If you downloaded the file:</strong> use the download link from your purchase email. Replace your old
            PlantCare.html with the new one — your <code>.plants</code> file is separate and is not touched by this.
          </p>
          <p class="text-bark-500">
            Purchase links last thirty days. If yours has expired, reply to your purchase email and you will get a new
            one; there is no account to log in to.
          </p>
        </div>
        <p class="mt-5">
          <a href={APP_URL} class="btn-secondary">Open the installable app</a>
        </p>
      </div>

      <h2 class="mt-12 text-2xl font-semibold text-bark-900">Version history</h2>
      <div class="mt-6 space-y-8">
        {
          RELEASES.map((r) => (
            <article class="border-l-2 border-moss-200 pl-5">
              <div class="flex flex-wrap items-baseline gap-3">
                <h3 class="font-display text-xl font-semibold text-bark-900">Version {r.version}</h3>
                <time class="text-sm text-bark-500" datetime={r.date}>
                  {new Date(r.date + 'T00:00:00Z').toLocaleDateString('en-GB', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                    timeZone: 'UTC',
                  })}
                </time>
              </div>
              <p class="mt-2 text-sm font-medium text-bark-800">{r.headline}</p>
              <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-bark-600">
                {r.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <p class="mt-12 text-sm text-bark-500">
        <a href={PATHS.marketing} class="hover:text-moss-800">← {PRODUCT_NAME}</a>
      </p>
    </div>
  </section>
</Layout>
