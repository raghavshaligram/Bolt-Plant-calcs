---
/**
 * /plant-care/ — conversion-first product page.
 *
 * The demo is public at /app/. This page’s first job is therefore to help
 * people recognize a familiar plant-care problem, then let them experience
 * the solution before asking for the one-time purchase.
 */
import Layout from '../../layouts/Layout.astro';
import {
  APP_URL,
  COMPARISON,
  FACTS,
  LAUNCHED,
  NOT_INCLUDED,
  PATHS,
  PRICE_DISPLAY,
  PRODUCT_NAME,
} from '../../data/plantCare';

const title = 'Plant Care: Know what your plants need today';
const description =
  `A calmer way to care for your plants: see what needs attention, diagnose common problems, and try the full demo free. ${PRICE_DISPLAY} once to own it.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: PRODUCT_NAME,
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Any browser. Windows, macOS, Linux, iOS, Android.',
  description,
  offers: {
    '@type': 'Offer',
    price: '29.00',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: `https://harvestmath.com${PATHS.marketing}`,
  },
};

const faqs = [
  {
    q: 'Can I try Plant Care before I buy?',
    a: 'Yes. The public demo at /app/ lets you experience the workflow before buying. No account is required to try it.',
  },
  {
    q: 'Is this really a one-time payment?',
    a: `Yes. ${PRICE_DISPLAY}, once. There is no subscription, nothing to cancel, and updates are free.`,
  },
  {
    q: 'What do I get when I buy?',
    a: 'A downloadable app file you keep, plus an installable version for your phone. They are the same app: one is convenient on a phone, and the other is yours to retain.',
  },
  {
    q: 'Does it identify a plant from a photo or send notifications?',
    a: 'No. Plant Care focuses on practical schedules, diagnosis, light checks, and your own plant history. Photo identification and closed-app notifications require services this privacy-first app does not use.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const storySteps = [
  {
    number: '01',
    title: 'Something looks wrong',
    body: 'A yellow leaf, a drooping stem, or the familiar feeling that you cannot remember when you last watered.',
    icon: 'leaf',
  },
  {
    number: '02',
    title: 'Open Plant Care',
    body: 'Your Today list tells you what needs attention. The diagnosis walkthrough gives you a sensible first check.',
    icon: 'check',
  },
  {
    number: '03',
    title: 'Know your next step',
    body: 'Care becomes a small, clear action — not a late-night search through conflicting advice.',
    icon: 'sun',
  },
];

const visualFeatures = [
  {
    eyebrow: 'YOUR DAY, SORTED',
    title: 'Open the app. Know what needs doing.',
    body: 'Late jobs come first, then today, then the week ahead. A calm list beats trying to remember every plant in your head.',
    image: 'today.png',
    alt: 'The Today screen listing late and due jobs for ten plants',
    side: 'image-first',
  },
  {
    eyebrow: 'WHEN A PLANT CHANGES',
    title: 'Turn “what is wrong?” into a next check.',
    body: 'Work through yellow leaves, wilting, brown tips, holes, and more — then keep the decision in that plant’s journal.',
    image: 'plant.png',
    alt: 'A plant detail screen showing care intervals, species notes, and a journal',
    side: 'copy-first',
  },
  {
    eyebrow: 'MAKE THE SPACE WORK',
    title: 'Check the light before you move the plant.',
    body: 'Use the built-in light meter to understand a spot, then see whether a particular plant belongs there.',
    image: 'light.png',
    alt: 'The light meter showing a reading and whether a plant suits the spot',
    side: 'image-first',
  },
];

const confidencePoints = [
  `${FACTS.species} plants in the reference`,
  `${FACTS.careTypes} care types, beyond watering`,
  'Works with the wifi off',
  'Free updates, forever',
];
---

<Layout title={title} description={description} noindex={!LAUNCHED} ogImage="/plant-care/shots/today.png">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} slot="head" />

  {
    !LAUNCHED && (
      <div class="border-b border-clay-200 bg-clay-50">
        <div class="container-wide py-3 text-sm text-clay-800">
          <strong>Not live yet.</strong> This page is not indexed and checkout does not take payments until launch setup is complete.
        </div>
      </div>
    )
  }

  <!-- Hero: outcome first, demo first -->
  <section class="relative overflow-hidden border-b border-moss-100 bg-gradient-to-br from-moss-50 via-sand-50 to-moss-100/40">
    <div class="absolute -right-32 -top-32 h-96 w-96 rounded-full bg-moss-200/40 blur-3xl"></div>
    <div class="absolute -bottom-24 left-1/4 h-64 w-64 rounded-full bg-sand-200/50 blur-3xl"></div>

    <div class="container-wide relative grid gap-10 py-14 lg:grid-cols-[1fr_0.9fr] lg:items-center lg:py-20">
      <div class="max-w-2xl">
        <p class="inline-flex rounded-full bg-moss-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-moss-800">
          Meet HarvestMath Plant Care
        </p>
        <h1 class="mt-5 font-display text-4xl font-semibold tracking-tight text-bark-900 sm:text-5xl lg:text-6xl">
          Stop guessing what your plants need.
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-bark-700 sm:text-xl">
          See what needs care today, understand what looks wrong, and keep every plant&rsquo;s routine in one calm place.
        </p>
        <p class="mt-3 text-base leading-relaxed text-bark-600">
          Try the real app first. No account required.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href={APP_URL} class="btn-primary px-7 py-3 text-base">Try the free demo</a>
          <a href={PATHS.buy} class="btn-secondary px-6 py-3 text-base">Own it for {PRICE_DISPLAY} once</a>
        </div>
        <p class="mt-4 text-sm text-bark-600">No subscription. No account. Your plant records stay with you.</p>

        <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-3 text-sm text-bark-700">
          {confidencePoints.map((point) => (
            <p class="flex items-center gap-2">
              <span class="flex h-5 w-5 items-center justify-center rounded-full bg-moss-100 text-moss-700">✓</span>
              {point}
            </p>
          ))}
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-md lg:max-w-none">
        <div class="absolute -inset-5 rounded-[2.5rem] bg-gradient-to-br from-moss-200/70 to-sand-100/70 blur-xl"></div>
        <div class="relative overflow-hidden rounded-[2rem] border-8 border-bark-900 bg-bark-900 p-2 shadow-2xl">
          <img
            src="/plant-care/shots/phone-today.png"
            alt="The Today screen of HarvestMath Plant Care on a phone, listing late and due jobs"
            width="420"
            height="884"
            class="w-full rounded-[1.45rem]"
            loading="eager"
          />
        </div>
        <div class="absolute -bottom-5 -left-4 rounded-2xl border border-moss-100 bg-white px-4 py-3 shadow-card">
          <p class="text-xs font-semibold uppercase tracking-wide text-moss-700">A calmer morning</p>
          <p class="mt-0.5 text-sm font-medium text-bark-900">Everything due, in one place.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Relatable narrative -->
  <section class="border-b border-moss-100 bg-white">
    <div class="container-wide py-14 sm:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-moss-700">A familiar pattern</p>
        <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight text-bark-900 sm:text-4xl">
          You bought the plant. Then life got busy.
        </h2>
        <p class="mt-4 text-base leading-relaxed text-bark-600">
          It looked great in the shop. A few weeks later, a leaf turns yellow, another plant droops, and you cannot remember whether you watered on Sunday or last Wednesday.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {storySteps.map((step) => (
          <div class="relative overflow-hidden rounded-2xl border border-moss-100 bg-gradient-to-br from-white to-moss-50/50 p-6 shadow-card">
            <span class="font-display text-5xl font-semibold text-moss-100">{step.number}</span>
            <div class="mt-5 flex h-10 w-10 items-center justify-center rounded-xl bg-moss-100 text-moss-700">
              {step.icon === 'leaf' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 4C11 4 5 8 5 15a5 5 0 0 0 5 5c7 0 10-7 10-16Z"/><path d="M4 20c3-4 6-6 11-8"/></svg>}
              {step.icon === 'check' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>}
              {step.icon === 'sun' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19m0-14-1.5 1.5m-11 11L5 19"/></svg>}
            </div>
            <h3 class="mt-4 font-display text-xl font-semibold text-bark-900">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-bark-600">{step.body}</p>
          </div>
        ))}
      </div>

      <div class="mt-10 text-center">
        <a href={APP_URL} class="btn-primary">See how it feels in the demo</a>
      </div>
    </div>
  </section>

  <!-- Visual product tour -->
  <section class="border-b border-moss-100 bg-sand-50">
    <div class="container-wide py-14 sm:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-moss-700">A simple loop</p>
        <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight text-bark-900 sm:text-4xl">
          Notice. Open. Know what to do.
        </h2>
      </div>

      <div class="mt-12 space-y-16 lg:space-y-24">
        {visualFeatures.map((feature) => (
          <div class={`grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-16 ${feature.side === 'copy-first' ? 'lg:[&>div:first-child]:order-2' : ''}`}>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-moss-700">{feature.eyebrow}</p>
              <h3 class="mt-3 font-display text-3xl font-semibold tracking-tight text-bark-900">{feature.title}</h3>
              <p class="mt-4 max-w-lg text-base leading-relaxed text-bark-600">{feature.body}</p>
              <a href={APP_URL} class="mt-6 inline-flex items-center text-sm font-semibold text-moss-700 hover:text-moss-800">
                Try this in the demo <span class="ml-1" aria-hidden="true">→</span>
              </a>
            </div>
            <div class="relative">
              <div class="absolute -inset-3 rounded-3xl bg-moss-100/70 blur-xl"></div>
              <img
                src={`/plant-care/shots/${feature.image}`}
                alt={feature.alt}
                width="900"
                class="relative w-full rounded-2xl border border-moss-100 bg-white shadow-card"
                loading="lazy"
              />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Demo-to-purchase bridge -->
  <section class="border-b border-moss-100 bg-white">
    <div class="container-wide py-14 sm:py-20">
      <div class="overflow-hidden rounded-3xl bg-moss-800 px-7 py-10 text-center sm:px-12 sm:py-14">
        <p class="text-sm font-semibold uppercase tracking-wide text-moss-200">Try it before you decide</p>
        <h2 class="mx-auto mt-3 max-w-2xl font-display text-3xl font-semibold tracking-tight text-white sm:text-4xl">
          The demo is the sales pitch.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-moss-100">
          Add a plant, see the care flow, and explore the tools. If it gives you the clarity your plants have been missing, keep it for {PRICE_DISPLAY} once.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a href={APP_URL} class="inline-flex items-center justify-center rounded-lg bg-white px-7 py-3 text-base font-semibold text-moss-800 transition hover:bg-moss-50">Open the free demo</a>
          <a href={PATHS.buy} class="inline-flex items-center justify-center rounded-lg border border-moss-400 px-7 py-3 text-base font-semibold text-white transition hover:bg-moss-700">Own Plant Care</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Concise comparison -->
  <section class="border-b border-moss-100 bg-sand-50">
    <div class="container-wide py-14 sm:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-moss-700">Why own it?</p>
        <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight text-bark-900">
          Plant care without another monthly bill.
        </h2>
      </div>

      <div class="mx-auto mt-10 max-w-4xl overflow-x-auto rounded-2xl border border-moss-100 bg-white shadow-card">
        <table class="w-full min-w-[38rem] border-collapse text-sm">
          <thead>
            <tr class="border-b border-moss-100 text-left">
              <th class="px-5 py-4 font-semibold text-bark-500"></th>
              <th class="px-5 py-4 font-semibold text-moss-800">Plant Care</th>
              <th class="px-5 py-4 font-semibold text-bark-500">Subscription apps</th>
            </tr>
          </thead>
          <tbody>
            {COMPARISON.filter((row) => ['Cost', 'If you stop paying', 'Account required', 'Works with no internet', 'Shows how it reached a schedule'].includes(row.what)).map((row) => (
              <tr class="border-b border-moss-50 last:border-b-0">
                <td class="px-5 py-4 font-medium text-bark-800">{row.what}</td>
                <td class="px-5 py-4 text-bark-700">{row.ours}</td>
                <td class="px-5 py-4 text-bark-600">{row.theirs}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-center text-xs text-bark-500">
        Plant Care does not offer photo identification or closed-app reminders. If those are the features you need, a subscription app may be a better fit.
      </p>
    </div>
  </section>

  <!-- Clear ownership / FAQ -->
  <section class="border-b border-moss-100 bg-white">
    <div class="container-prose py-14 sm:py-20">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-bark-900">A few honest questions</h2>
      <dl class="mt-6 divide-y divide-bark-100">
        {faqs.map((f) => (
          <div class="py-5">
            <dt class="font-display text-lg font-semibold text-bark-900">{f.q}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-bark-600">{f.a}</dd>
          </div>
        ))}
      </dl>

      <div class="mt-10 rounded-2xl border border-clay-200 bg-clay-50/60 p-6">
        <h3 class="font-display text-lg font-semibold text-clay-800">What it does not do</h3>
        <div class="mt-4 grid gap-4 sm:grid-cols-3">
          {NOT_INCLUDED.map((item) => (
            <div>
              <p class="font-semibold text-bark-800">{item.title.replace(/^No /, '')}</p>
              <p class="mt-1 text-sm leading-relaxed text-bark-600">{item.body.split('. ')[0]}.</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Final decision -->
  <section class="bg-moss-800">
    <div class="container-prose py-14 text-center">
      <h2 class="font-display text-3xl font-semibold text-white">Give your plants a clearer next step.</h2>
      <p class="mx-auto mt-3 max-w-xl text-moss-100">
        Start with the demo. Keep the app when it makes plant care feel lighter.
      </p>
      <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={APP_URL} class="inline-flex items-center justify-center rounded-lg bg-white px-8 py-3 text-base font-semibold text-moss-800 transition hover:bg-moss-50">Try the free demo</a>
        <a href={PATHS.buy} class="inline-flex items-center justify-center rounded-lg border border-moss-400 px-8 py-3 text-base font-semibold text-white transition hover:bg-moss-700">Own it for {PRICE_DISPLAY} once</a>
      </div>
      <p class="mt-4 text-xs text-moss-200">No account. No subscription. Free updates.</p>
    </div>
  </section>
</Layout>
