---
import Layout from '../../layouts/Layout.astro';
import { cropSpacing } from '../../data/crop-spacing';

const description =
  'Real, extension-sourced plant spacing for 15 individual crops -- exact in-row and between-row distances, why spacing matters for each one, and the genuine differences between varieties.';
const pageUrl = new URL('/plant-spacing/', Astro.site).href;

// Ordered by real search demand (highest first) rather than alphabetically --
// this is a directory people scan top-down looking for their crop, and the
// most-searched crops are the ones most visitors are actually looking for.
const sortedCrops = [...cropSpacing].sort((a, b) => b.searchVolume - a.searchVolume);

const teasers: Record<string, string> = {
  tomato: 'Determinate vs. indeterminate, and why staked, caged, and sprawling plants each need a different number.',
  pepper: 'The standard spacing, plus the counterintuitive case for planting closer together in hot climates.',
  strawberry: 'Matted row vs. hill system -- two genuinely different ways to grow the same crop.',
  onion: 'How spacing directly controls bulb size, from scallions to storage onions.',
  bean: 'Bush vs. pole beans -- different growth architectures, not just different numbers.',
  watermelon: 'Standard vines need serious room; genuine bush varieties don’t.',
  zucchini: 'The exact figure an extension service confirms for zucchini, plus hill planting.',
  carrot: 'Why thinning, not initial spacing, is the actual skill with carrots.',
  kale: 'A close look at in-row spacing, and why between-row needs more room than you’d guess.',
  squash: 'Winter squash: three species, and why only some can be trellised.',
  asparagus: 'Crown depth, permanent-bed spacing, and a 15-year-plus commitment.',
  lettuce: 'Leaf vs. head lettuce -- spacing that depends on how you plan to harvest.',
  cauliflower: 'Nearly the same spacing as broccoli -- blanching is what actually sets it apart.',
  'brussels-sprouts': 'A long season and a tall single stalk change the spacing math.',
  pea: 'Bush vs. vining peas, leafless cultivars, and the double-row trellis pattern.',
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Plant Spacing', item: pageUrl },
  ],
};

const collectionPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Plant Spacing by Crop',
  description,
  url: pageUrl,
  about: { '@type': 'Thing', name: 'Vegetable plant spacing by crop' },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: sortedCrops.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      url: new URL(`/plant-spacing/${c.slug}/`, Astro.site).href,
    })),
  },
};
---

<Layout title="Plant Spacing by Crop" description={description} rawTitle canonical={pageUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(collectionPageJsonLd)} slot="head" />

  <section class="border-b border-moss-100 bg-moss-50/60">
    <div class="container-wide py-12 sm:py-16">
      <nav class="flex text-sm text-bark-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-moss-800">Home</a>
        <span class="mx-2">/</span>
        <span class="text-bark-700">Plant Spacing</span>
      </nav>
      <h1 class="mt-4 font-display text-3xl font-semibold tracking-tight text-bark-900 sm:text-4xl lg:text-5xl">
        Plant Spacing by Crop
      </h1>
      <p class="mt-4 max-w-2xl text-base text-bark-600 sm:text-lg">
        Real, extension-sourced spacing for the crops gardeners search for most &mdash; each guide covers the actual numbers, the genuine differences between varieties, and why spacing matters for that specific crop. Planning a whole bed instead of one crop? Use the <a href="/calculators/plant-spacing-calculator/" class="font-medium text-moss-700 underline underline-offset-2 hover:text-moss-900">Plant Spacing Calculator</a>.
      </p>
    </div>
  </section>

  <section class="container-wide py-12 sm:py-16">
    <div class="mx-auto max-w-5xl">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {sortedCrops.map((c) => (
          <a
            href={`/plant-spacing/${c.slug}/`}
            class="group flex flex-col rounded-xl border border-moss-100 bg-white p-5 shadow-card ring-1 ring-transparent transition hover:-translate-y-0.5 hover:shadow-cardHover hover:ring-moss-200"
          >
            <span class="font-display text-lg font-semibold text-bark-900 group-hover:text-moss-800">{c.name} Spacing</span>
            <span class="mt-1.5 text-sm text-bark-600">{teasers[c.slug]}</span>
          </a>
        ))}
      </div>

      <div class="mx-auto mt-12 max-w-3xl">
        <div class="prose prose-bark max-w-none prose-headings:font-display prose-headings:text-bark-900 prose-a:text-moss-700">
          <p>
            Every guide above supplements &mdash; not replaces &mdash; the site&rsquo;s own <a href="/calculators/plant-spacing-calculator/">Plant Spacing Calculator</a>, which covers 20+ crops in one tool and works out exact plant counts for your own bed dimensions. These per-crop pages go deeper on the crops gardeners search for most: the real difference between varieties, why spacing matters for that specific plant, and the extension sources behind every number.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
