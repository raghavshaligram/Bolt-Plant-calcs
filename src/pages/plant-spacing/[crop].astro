---
// Per-crop plant spacing pages -- the pSEO set that supplements (does not
// replace) the multi-crop Plant Spacing Calculator. See
// src/data/crop-spacing.ts for the full editorial rationale, sourcing, and
// differentiation-gate notes. This file is purely a template: every word of
// actual content lives in that data file, per crop.

import Layout from '../../layouts/Layout.astro';
import BylineRow from '../../components/BylineRow.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import FAQBlock from '../../components/FAQBlock.astro';
import CropSiblingLinks from '../../components/CropSiblingLinks.astro';
import { cropSpacing, type CropSpacingEntry } from '../../data/crop-spacing';
import { CROP_PRESETS } from '../../components/calculators/usePlantSpacingCalculatorState';

export function getStaticPaths() {
  return cropSpacing.map((crop) => ({
    params: { crop: crop.slug },
    props: { crop },
  }));
}

const { crop } = Astro.props as { crop: CropSpacingEntry };

const pageUrl = new URL(`/plant-spacing/${crop.slug}/`, Astro.site).href;
const shareImage = new URL('/plant-spacing-calculator-garden-grid.png', Astro.site).href;

// "check before assuming" -- confirmed directly against the calculator's own
// CROP_PRESETS list rather than trusted from the data file alone, so a
// future rename of a preset can't silently produce a dead/no-op query param.
const presetIsValid = crop.calculatorPreset
  ? CROP_PRESETS.some((p) => p.name === crop.calculatorPreset)
  : false;
const calculatorHref = presetIsValid
  ? `/calculators/plant-spacing-calculator/?crop=${encodeURIComponent(crop.calculatorPreset!)}`
  : '/calculators/plant-spacing-calculator/';

const formattedDate = new Date(crop.lastUpdated + 'T00:00:00').toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const tocItems = [
  { id: 'spacing-at-a-glance', label: 'Spacing at a Glance', icon: 'table' as const },
  { id: 'differentiator', label: crop.differentiatorHeading, icon: 'leaf' as const },
  { id: 'why-spacing-matters', label: crop.whySpacingMattersHeading, icon: 'warning' as const },
  { id: 'faq', label: 'FAQ', icon: 'question' as const },
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Plant Spacing', item: new URL('/plant-spacing/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: crop.name, item: pageUrl },
  ],
};

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: crop.seoTitle,
  description: crop.metaDescription,
  image: shareImage,
  url: pageUrl,
  datePublished: '2026-09-17',
  dateModified: crop.lastUpdated,
  author: { '@type': 'Person', name: 'HarvestMath Editors', url: new URL('/about/', Astro.site).href },
  publisher: { '@type': 'Organization', name: 'HarvestMath', url: Astro.site!.href },
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
};

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'HarvestMath Editors',
  url: new URL('/about/', Astro.site).href,
  jobTitle: 'Editor',
  worksFor: { '@type': 'Organization', name: 'HarvestMath' },
};
---

<Layout title={crop.seoTitle} description={crop.metaDescription} rawTitle canonical={pageUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} slot="head" />

  <!-- Hero band: breadcrumb + H1 + byline row -->
  <section class="border-b border-moss-100 bg-moss-50/60">
    <div class="container-wide py-7 sm:py-9">
      <nav class="flex flex-wrap text-sm text-bark-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-moss-800">Home</a>
        <span class="mx-2">/</span>
        <a href="/plant-spacing/" class="hover:text-moss-800">Plant Spacing</a>
        <span class="mx-2">/</span>
        <span class="text-bark-700">{crop.name}</span>
      </nav>

      <h1 class="mt-3 font-display text-3xl font-semibold tracking-tight text-bark-900 sm:text-4xl">
        {crop.name} Plant Spacing: How Far Apart to Plant {crop.pluralName}
      </h1>

      <BylineRow
        authorName="HarvestMath Editors"
        authorUrl="/about/"
        lastUpdated={crop.lastUpdated}
        readingTime="5 min read"
        shareTitle={crop.seoTitle}
        shareDescription={crop.metaDescription}
        shareImage={shareImage}
      />
    </div>
  </section>

  <!-- Two-column main area: article content left, sidebar TOC right -->
  <div class="container-wide py-6 sm:py-8">
    <div class="lg:grid lg:grid-cols-[1fr_240px] lg:gap-12">
      <div class="min-w-0">
        <TableOfContents items={tocItems} variant="accordion" />

        <article class="prose prose-bark mt-6 max-w-none prose-headings:font-display prose-headings:text-bark-900 prose-h2:mt-12 prose-h2:scroll-mt-24 prose-h2:text-2xl prose-h2:font-semibold prose-h3:text-lg prose-h3:font-semibold prose-a:text-moss-700 prose-strong:text-bark-900">

          <p set:html={crop.directAnswer} />

          <h2 id="spacing-at-a-glance">Spacing at a Glance</h2>
          <div class="not-prose my-6 overflow-x-auto rounded-2xl border border-moss-100">
            <table class="w-full text-left text-sm">
              <caption class="sr-only">{crop.name} spacing reference</caption>
              <thead class="bg-moss-50">
                <tr>
                  <th scope="col" class="p-3 font-semibold text-bark-900">Type</th>
                  <th scope="col" class="p-3 font-semibold text-bark-900">In-row spacing</th>
                  <th scope="col" class="p-3 font-semibold text-bark-900">Between-row spacing</th>
                  <th scope="col" class="p-3 font-semibold text-bark-900">SFG (per sq ft)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-moss-100">
                {crop.spacingTable.map((row) => (
                  <tr>
                    <th scope="row" class="p-3 font-semibold text-bark-900">{row.rowLabel}</th>
                    <td class="p-3">{row.inRow}</td>
                    <td class="p-3">{row.betweenRow}</td>
                    <td class="p-3">{row.sqft}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {crop.spacingTableNote && <p class="text-xs text-bark-500" set:html={crop.spacingTableNote} />}
          <p set:html={crop.bedPlantsNote} />

          <h2 id="differentiator">{crop.differentiatorHeading}</h2>
          {crop.differentiatorParagraphs.map((p) => <p set:html={p} />)}

          <h2 id="why-spacing-matters">{crop.whySpacingMattersHeading}</h2>
          {crop.whySpacingMattersParagraphs.map((p) => <p set:html={p} />)}

          {crop.nonObviousFact && (
            <div class="not-prose my-6 rounded-2xl border border-moss-200 bg-moss-50/60 p-5">
              <p class="text-sm text-bark-700" set:html={crop.nonObviousFact} />
            </div>
          )}

          <div class="not-prose my-8 rounded-2xl border border-moss-200 bg-moss-50/60 p-6">
            <p class="text-bark-700">
              Ready to plan an actual bed? The <a href="/calculators/plant-spacing-calculator/" class="font-medium underline underline-offset-2 hover:text-moss-900">Plant Spacing Calculator</a> works out exact plant counts for your own bed dimensions
              {presetIsValid ? (
                <> &mdash; <a href={calculatorHref} class="font-medium underline underline-offset-2 hover:text-moss-900">open it pre-set to {crop.calculatorPreset}</a>.</>
              ) : (
                <>. It doesn't have a dedicated {crop.name} preset yet, so enter the figures from the chart above under &ldquo;Custom.&rdquo;</>
              )}
            </p>
          </div>

          <FAQBlock id="faq" heading={`${crop.name} Spacing FAQ`} faqs={crop.faqs} />

          <h2 id="sources-and-further-reading">Sources &amp; further reading</h2>
          <p>
            Spacing figures and facts on this page are sourced directly from university cooperative extension services, cited below &mdash; not estimated or invented.
          </p>
          <ul>
            {crop.sources.map((s) => (
              <li>
                <a href={s.url} rel="noopener noreferrer">{s.label}</a> &mdash; {s.institution}
              </li>
            ))}
          </ul>
          <p>
            For more on how we source and validate the figures used across this site, see our <a href="/methodology/">methodology page</a>.
          </p>
        </article>

        <CropSiblingLinks crop={crop} />
      </div>

      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <TableOfContents items={tocItems} variant="sidebar" />
        </div>
      </aside>
    </div>
  </div>
</Layout>
