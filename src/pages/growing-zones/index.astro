---
import Layout from '../../layouts/Layout.astro';
import { states, type LiveState } from '../../data/states';

const description =
  'USDA hardiness zones and frost dates by state. Find your state\'s zone range, major city zones, average frost dates, and what actually grows well there.';
const pageUrl = new URL('/growing-zones/', Astro.site).href;

const sortedStates = [...states].sort((a, b) => a.name.localeCompare(b.name));
const liveStates = sortedStates.filter((s): s is LiveState => s.status === 'live');

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Growing Zones', item: pageUrl },
  ],
};

const collectionPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Growing Zones & Frost Dates by State',
  description,
  url: pageUrl,
  about: { '@type': 'Thing', name: 'USDA hardiness zones and frost dates by US state' },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: liveStates.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.name,
      url: new URL(`/growing-zones/${s.slug}/`, Astro.site).href,
    })),
  },
};
---

<Layout title="Growing Zones & Frost Dates by State" description={description} rawTitle canonical={pageUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(collectionPageJsonLd)} slot="head" />

  <section class="border-b border-moss-100 bg-moss-50/60">
    <div class="container-wide py-12 sm:py-16">
      <nav class="flex text-sm text-bark-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-moss-800">Home</a>
        <span class="mx-2">/</span>
        <span class="text-bark-700">Growing Zones</span>
      </nav>
      <h1 class="mt-4 font-display text-3xl font-semibold tracking-tight text-bark-900 sm:text-4xl lg:text-5xl">
        Growing Zones &amp; Frost Dates by State
      </h1>
      <p class="mt-4 max-w-2xl text-base text-bark-600 sm:text-lg">
        USDA hardiness zone range, major city zones, average frost dates, and real zone-appropriate plants for each state &mdash; sourced from the 2023 USDA Plant Hardiness Zone Map and state extension services. For your exact zone, use the <a href="/calculators/hardiness-zone-finder/" class="font-medium text-moss-700 underline underline-offset-2 hover:text-moss-900">Hardiness Zone Finder</a>.
      </p>
    </div>
  </section>

  <section class="container-wide py-12 sm:py-16">
    <div class="mx-auto max-w-4xl">
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
        {sortedStates.map((s) =>
          s.status === 'live' ? (
            <a
              href={`/growing-zones/${s.slug}/`}
              class="group flex flex-col rounded-xl border border-moss-100 bg-white p-4 shadow-card ring-1 ring-transparent transition hover:-translate-y-0.5 hover:shadow-cardHover hover:ring-moss-200"
            >
              <span class="font-display text-base font-semibold text-bark-900 group-hover:text-moss-800">{s.name}</span>
              <span class="mt-1 text-xs text-bark-500">Zone {s.zoneRangeLow}&ndash;{s.zoneRangeHigh}</span>
            </a>
          ) : (
            <div class="flex flex-col rounded-xl border border-dashed border-moss-200 bg-white/60 p-4">
              <span class="text-base font-medium text-bark-500">{s.name}</span>
              <span class="mt-1 inline-flex w-fit items-center rounded-full bg-bark-100 px-2 py-0.5 text-xs font-medium uppercase tracking-wider text-bark-500">
                Coming soon
              </span>
            </div>
          )
        )}
      </div>

      <div class="mx-auto mt-12 max-w-3xl">
        <div class="prose prose-bark max-w-none prose-headings:font-display prose-headings:text-bark-900 prose-a:text-moss-700">
          <p>
            Every state page above is built the same way: real zone data from the 2023 USDA Plant Hardiness Zone Map, cross-checked at the city level, plus frost dates and plant picks sourced from state extension services &mdash; not generic filler. For what a hardiness zone actually measures (and what it doesn't), see <a href="/blog/usda-hardiness-zones-explained/">how zones actually work</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
